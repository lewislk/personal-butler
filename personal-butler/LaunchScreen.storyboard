<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchScreen.storyboard
  系统级启动屏：App 进程冷启（SwiftUI 首帧之前，约 2~3 秒）阶段展示。
  视觉与 Presentation/Views/LaunchView.swift 对齐——白底、主色圆角方块 + SF Symbol 图标、
  下方双行文字——让"系统启动屏 → SwiftUI LaunchView → 主页"三段过渡无缝、无白屏。
  storyboard 不能放动画/ProgressView/runtime attribute，圆角方块用 SF Symbol `app.fill`
  染色实现；呼吸动画和菊花指示由后续接管的 LaunchView 展现。
-->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="22505" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22504"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--Launch View Controller-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="Ze5-6b-2t3">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <!-- 底层：主色 #4A86E8 圆角方块（用 SF Symbol app.fill 染色实现，
                                 绕开 storyboard 不允许 runtime attribute 设 cornerRadius 的限制） -->
                            <imageView opaque="NO" clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleAspectFit" image="app.fill" catalog="system" translatesAutoresizingMaskIntoConstraints="NO" id="bg-oo-log">
                                <rect key="frame" x="148" y="330" width="96" height="96"/>
                                <color key="tintColor" red="0.29" green="0.525" blue="0.91" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="96" id="wid-oo-log"/>
                                    <constraint firstAttribute="height" constant="96" id="hgt-oo-log"/>
                                </constraints>
                            </imageView>
                            <!-- 上层图标 -->
                            <imageView opaque="NO" clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleAspectFit" image="person.crop.circle.badge.checkmark" catalog="system" translatesAutoresizingMaskIntoConstraints="NO" id="img-oo-img">
                                <rect key="frame" x="173" y="355" width="46" height="46"/>
                                <color key="tintColor" red="1" green="1" blue="1" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="46" id="hgt-oo-img"/>
                                    <constraint firstAttribute="width" constant="46" id="wid-oo-img"/>
                                </constraints>
                            </imageView>
                            <!-- 主标题："私人管家" -->
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="私人管家" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="tit-oo-lbl">
                                <rect key="frame" x="0" y="442" width="393" height="30"/>
                                <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="24"/>
                                <color key="textColor" red="0.114" green="0.114" blue="0.122" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <!-- 副标题："你的生活，尽在掌握" -->
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="你的生活，尽在掌握" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="sub-oo-lbl">
                                <rect key="frame" x="0" y="480" width="393" height="18"/>
                                <fontDescription key="fontDescription" type="system" pointSize="13"/>
                                <color key="textColor" red="0.459" green="0.459" blue="0.459" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                <nil key="highlightedColor"/>
                            </label>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="6Tk-OE-BBY"/>
                        <color key="backgroundColor" red="1" green="1" blue="1" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="bg-oo-log" firstAttribute="centerX" secondItem="Ze5-6b-2t3" secondAttribute="centerX" id="cx-oo-log"/>
                            <constraint firstItem="bg-oo-log" firstAttribute="centerY" secondItem="Ze5-6b-2t3" secondAttribute="centerY" multiplier="0.85" id="cy-oo-log"/>
                            <constraint firstItem="img-oo-img" firstAttribute="centerX" secondItem="bg-oo-log" secondAttribute="centerX" id="cx-oo-img"/>
                            <constraint firstItem="img-oo-img" firstAttribute="centerY" secondItem="bg-oo-log" secondAttribute="centerY" id="cy-oo-img"/>
                            <constraint firstItem="tit-oo-lbl" firstAttribute="top" secondItem="bg-oo-log" secondAttribute="bottom" constant="16" id="top-oo-tit"/>
                            <constraint firstItem="tit-oo-lbl" firstAttribute="leading" secondItem="Ze5-6b-2t3" secondAttribute="leading" id="ldg-oo-tit"/>
                            <constraint firstItem="tit-oo-lbl" firstAttribute="trailing" secondItem="Ze5-6b-2t3" secondAttribute="trailing" id="trl-oo-tit"/>
                            <constraint firstItem="sub-oo-lbl" firstAttribute="top" secondItem="tit-oo-lbl" secondAttribute="bottom" constant="6" id="top-oo-sub"/>
                            <constraint firstItem="sub-oo-lbl" firstAttribute="leading" secondItem="Ze5-6b-2t3" secondAttribute="leading" id="ldg-oo-sub"/>
                            <constraint firstItem="sub-oo-lbl" firstAttribute="trailing" secondItem="Ze5-6b-2t3" secondAttribute="trailing" id="trl-oo-sub"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iYj-Kq-Ea1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="53" y="140"/>
        </scene>
    </scenes>
    <resources>
        <image name="app.fill" catalog="system" width="128" height="121"/>
        <image name="person.crop.circle.badge.checkmark" catalog="system" width="128" height="121"/>
    </resources>
</document>
